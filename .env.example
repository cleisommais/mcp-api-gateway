# Settings only. Credentials belong in ignored secrets/ files.
# The Bash initializer appends LOCAL_UID/LOCAL_GID for Unix bind-mount access.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=0
# Atlassian account email for Bitbucket API-token Basic authentication.
BITBUCKET_EMAIL=
OLLAMA_VERSION=0.40.16
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_THINK=low
CLEAN_AUDIT_THINK=medium
CLEAN_AUDIT_CONTEXT_LENGTH=16384
CLEAN_AUDIT_OUTPUT_TOKENS=8192
REVIEW_MODE=single
REVIEW_PROMPT_PROFILE=original
EXTERNAL_INFERENCE_ENABLED=false
EXTERNAL_MAX_COST_USD=0
