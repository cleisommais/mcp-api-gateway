# Run scripts/Initialize-LocalEnvironment.ps1 to create a local password.
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=15432
OLLAMA_HOST_PORT=11435
OLLAMA_VERSION=0.40.16
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_CONTEXT_LENGTH=8192
GATEWAY_TOKEN=
GATEWAY_HOST_PORT=18080
REVIEW_PROMPT_PROFILE=calibrated
OLLAMA_THINK=medium
REVIEW_OUTPUT_TOKENS=4096
WEBHOOK_SECRET=
EDGE_HOST_PORT=18081
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=0
PUBLISH_REVIEWS=false
# Required only by the explicit gitlab-publish profile. Never passed to the gateway/model.
GITLAB_PUBLISH_TOKEN=
GITLAB_READ_TOKEN=
MODEL_PROVIDER=ollama
REVIEW_MODE=single
VERIFIER_PROVIDER=ollama
VERIFIER_MODEL=qwen3:14b
VERIFIER_THINK=false
VERIFIER_OUTPUT_TOKENS=1536
REVIEW_MAX_MODEL_CALLS=8
REVIEW_TOTAL_SECONDS=360
# External profiles require explicit enablement, a positive approved budget and a key file.
EXTERNAL_INFERENCE_ENABLED=false
EXTERNAL_ALLOWED_REPOSITORIES=github:cleisommais/pr-test-repo
EXTERNAL_MAX_COST_USD=0
OPENAI_KEY_FILE_ON_HOST=./model-secrets/openai-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_REASONING=medium
